{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["bin/**", "dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "outputs": []
    },
    "test:integration": {
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
