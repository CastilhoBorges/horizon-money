{
  "name": "horizon-money",
  "private": true,
  "description": "Open-source, self-hosted personal-finance forecasting you connect to your AI agent through MCP.",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --env-mode=loose",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --env-mode=loose",
    "gen": "turbo run gen",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "db:up": "docker compose --profile dev up -d postgres mailpit",
    "db:down": "docker compose --profile dev down",
    "db:worktree": "node scripts/db-worktree.mjs",
    "docs:index": "node scripts/docs-index.mjs",
    "docs:check": "node scripts/docs-index.mjs --check",
    "test:tooling": "node --test \"scripts/*.test.mjs\" \".claude/hooks/*.test.mjs\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.4",
    "turbo": "2.11.13"
  }
}
