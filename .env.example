# Copy to .env and adjust. Every variable is optional unless marked required.

# --- Core ---------------------------------------------------------------------
# Postgres connection used by `pnpm dev` (compose sets its own for the container).
DATABASE_URL=postgres://horizon:horizon@localhost:5432/horizon?sslmode=disable
# Admin connection the integration tests create throwaway databases through (`pnpm test:integration`).
# Without it those tests skip. In a worktree, `pnpm db:worktree <slug>` prints its own DATABASE_URL.
TEST_DATABASE_URL=postgres://horizon:horizon@localhost:5432/postgres?sslmode=disable
PORT=8080
LOG_LEVEL=info

# Public HTTPS URL of this install. Required for OAuth and MCP connectors in production.
APP_BASE_URL=http://localhost:8080

# Allow new accounts. Turn off after creating yours.
SIGNUP_ENABLED=true
# Set to false only for local development over plain HTTP.
COOKIE_SECURE=false

# --- Google sign-in (optional) ---------------------------------------------------
# Create an OAuth client in Google Cloud; the redirect URI is <APP_BASE_URL>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email over SMTP (optional; enables password-reset emails) ------------------
# Local development: run `pnpm db:up` and use Mailpit (host localhost, port 1025, no TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Horizon Money <noreply@example.com>"
SMTP_TLS=starttls
